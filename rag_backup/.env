# ssh -fN dev229-api
# ps aux | grep 'ssh.*dev229-api'
OPENAI_API_KEY='beoh3xxRrBwJ1uNVX6jn4QibSW9aexjga5OKw7qyuxm8QNVg'
# OPENAI_BASE_URL='http://47.243.159.229:8081/v1'
OPENAI_BASE_URL="http://127.0.0.1:18081/v1"
OUTPUT_DIR=./output
# PARSER=mineru  # CPU/GPU 本地解析，需要安装 mineru
# PARSER=docling  # 另一种本地解析器
PARSER=vlm  # 使用视觉大模型解析，适合无GPU服务器，只需要 pdf2image
PARSE_METHOD=auto
LLM_MODEL_NAME="qwen-flash"
# VLM_MODEL_NAME="qwen3-vl-plus"  # 使用视觉模型
VLM_MODEL_NAME = 'qwen3-vl-flash'
# VLM_MODEL_NAME = 'qwen3-vl-32b-instruct'
VLM_WORKER_COUNT=20  # 页级解析并发worker数量（建议5-20，视API限流而定）
GRAPH_WORKER_COUNT=20  # 图谱构建并发数
EMBEDDING_MODEL="text-embedding-v4"  # API模型
# USE_LOCAL_EMBEDDING=false  # 是否使用本地embedding
# LOCAL_EMBEDDING_MODEL="BAAI/bge-large-zh-v1.5"  # 本地模型名称
EMBEDDING_BATCH_NUM=10  # LightRAG批量大小（API最大10条/批）
MAX_ASYNC=300  # LLM并发数（实体关系抽取）加倍
MAX_PARALLEL_INSERT=30  # 页面级并发（MAX_ASYNC/3）
EMBEDDING_FUNC_MAX_ASYNC=2  # Embedding并发数（降低避免429限流）
# MAX_CONCURRENT_FILES=1  # 已废弃，现在使用 VLM_WORKER_COUNT 控制页级并发
ENABLE_IMAGE_PROCESSING=false
ENABLE_TABLE_PROCESSING=false
ENABLE_EQUATION_PROCESSING=false
CHUNK_SIZE=12000

# HuggingFace 镜像站配置（访问国外模型）
HF_ENDPOINT=https://hf-mirror.com

# OceanBase Config
OCEANBASE_URI=127.0.0.1:2881
OCEANBASE_USER=root
OCEANBASE_PASSWORD=
OCEANBASE_DBNAME=oceanbase